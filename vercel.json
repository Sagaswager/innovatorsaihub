{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "innovatorsaihub.com"
        }
      ],
      "destination": "https://www.innovatorsaihub.com/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/WhatsAppautomaton",
      "destination": "https://wa.innovatorsaihub.com/WhatsAppautomaton"
    },
    {
      "source": "/WhatsAppautomaton/:path*",
      "destination": "https://wa.innovatorsaihub.com/WhatsAppautomaton/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}